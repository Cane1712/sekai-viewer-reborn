{
  "name": "@platform/ui-shell",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --config ./vitest.config.ts",
    "test:coverage": "vitest run --config ./vitest.config.ts --coverage && node ../../scripts/lcov/normalize-lcov.mjs coverage/lcov.info packages/ui-shell",
    "lint": "eslint src --ext .ts,.svelte",
    "check": "pnpm exec svelte-check --tsconfig ./tsconfig.json --tsgo"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./image-retry": {
      "types": "./src/image-retry/index.ts",
      "svelte": "./src/image-retry/index.ts",
      "default": "./src/image-retry/index.ts"
    },
    "./asset-image": {
      "types": "./src/asset-image.ts",
      "svelte": "./src/asset-image.svelte",
      "default": "./src/asset-image.svelte"
    },
    "./card-thumbnail": {
      "types": "./src/card-thumbnail-data.ts",
      "default": "./src/card-thumbnail-data.ts"
    },
    "./honor-degree-adapter": {
      "types": "./src/honor-degree-adapter.ts",
      "default": "./src/honor-degree-adapter.ts"
    },
    "./theme-controls": {
      "types": "./src/theme-controls.types.ts",
      "default": "./src/theme-controls.types.ts"
    },
    "./global-notices": {
      "types": "./src/global-notices.ts",
      "default": "./src/global-notices.ts"
    },
    "./page-title": {
      "types": "./src/page-title.ts",
      "default": "./src/page-title.ts"
    },
    "./inputs.css": "./src/inputs.css"
  },
  "dependencies": {
    "@iconify/svelte": "^5.2.1",
    "howler": "^2.2.4"
  },
  "devDependencies": {
    "@testing-library/svelte": "^5.4.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^25.9.5",
    "jsdom": "^30.0.1",
    "svelte": "^5.56.2",
    "svelte-check": "^4.6.0",
    "vite": "8.3.1",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
